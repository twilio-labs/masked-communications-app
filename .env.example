# Twilio Credentials (Required)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Webhook Domain (Required for production)
DOMAIN=

# Basic Auth for /sessions endpoint (Required)
AUTH_USERNAME=
AUTH_PASSWORD=

# Call Announcements (Optional)
CALL_ANNOUCEMENT_VOICE=Polly.Joanna
CALL_ANNOUCEMENT_LANGUAGE=en-US
OUT_OF_SESSION_MESSAGE_FOR_CALL=Sorry, you do not have an active session.
CONNECTING_CALL_ANNOUCEMENT=Please wait while we connect your call.

# Logging (Optional)
LOG_LEVEL=info

# Node Environment (Optional)
# NODE_ENV=test

# Server Port (Optional)
PORT=3000